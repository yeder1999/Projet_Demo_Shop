pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'GENERATE_ALLURE',
            defaultValue: false,
            description: 'Activer la génération et la publication du rapport Allure'
        )
    }

    stages {

        stage('Préparation du projet') {
            steps {
                echo 'Préparation du projet Maven...'

                sh 'java -version'
                sh 'mvn -version'

                sh 'mvn clean install -DskipTests'
            }
        }

        stage('Préparation des résultats') {
            steps {
                sh '''
                    echo "Suppression des anciens résultats..."

                    rm -rf target/allure-results
                    rm -rf target/allure-report

                    mkdir -p target/allure-results

                    echo "Répertoires de résultats prêts."
                '''
            }
        }

        stage('Tests automatisés') {
            steps {
                script {

                    try {

                        echo 'Lancement des tests Selenium + JUnit...'

                        sh 'mvn test -Dgroups=smoke'

                    } finally {

                        if (params.GENERATE_ALLURE) {

                            echo 'Préparation du rapport Allure...'

                            sh '''
                                if [ -d "target/allure-results" ]; then
                                    echo "Résultats Allure trouvés."
                                else
                                    echo "Aucun résultat Allure trouvé."
                                    mkdir -p target/allure-results
                                fi
                            '''
                        }
                    }
                }
            }
        }
    }

    post {

        always {
            echo 'Archivage des résultats de tests...'

            junit(
                testResults: 'target/surefire-reports/*.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts: 'target/surefire-reports/**,target/allure-results/**,target/screenshots/**',
                allowEmptyArchive: true
            )

            script {

                if (params.GENERATE_ALLURE) {

                    echo 'Publication du rapport Allure...'

                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [
                            [path: 'target/allure-results']
                        ]
                    )
                }
            }
        }

        success {
            echo 'Les tests automatisés sont terminés avec succès.'
        }

        failure {
            echo 'Les tests automatisés ont échoué.'
        }
    }
}